# Local development values only. Copy to .env and change the passwords before any shared use.
POSTGRES_PASSWORD=local-postgres-change-me
PIPELINE_DB_PASSWORD=local-pipeline-change-me
MCP_DB_PASSWORD=local-mcp-change-me
GRAFANA_DB_PASSWORD=local-grafana-change-me
AIRFLOW_DB_PASSWORD=local-airflow-db-change-me
REDIS_PASSWORD=local-redis-change-me

AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=local-airflow-change-me
AIRFLOW_SECRET_KEY=local-airflow-secret-change-me
GRAFANA_ADMIN_PASSWORD=local-grafana-admin-change-me

MCP_TOKEN=local-mcp-token-change-me
MCP_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# floci (local AWS). test/test only. Never put a real AWS key here.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566

# demo knobs
DEMO_EVENTS=100000
# Leave AIRFLOW_VAR_FORCE_FAIL unset. Airflow reads env before its database, so even an empty
# value would hide the FORCE_FAIL Variable that the demo sets. Set it to 1 only to force one ETL failure.

# host ports, change only if something else on your machine already uses them
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
AIRFLOW_PORT=8080
MCP_PORT=8765
