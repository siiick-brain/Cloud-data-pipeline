erDiagram
    dim_customer ||--o{ fact_order_line : customer_key
    dim_product  ||--o{ fact_order_line : product_key
    dim_store    ||--o{ fact_order_line : store_key
    dim_date     ||--o{ fact_order_line : date_key

    fact_order_line {
        uuid event_id PK
        text order_id
        smallint line_number
        int customer_key FK
        int product_key FK
        int store_key FK
        int date_key FK
        int quantity
        numeric unit_price
        char currency
        numeric net_amount
        timestamptz occurred_at
        date load_date
    }
    dim_customer {
        int customer_key PK
        text customer_id
        text full_name
        text email
        text city "SCD2"
        text address "SCD2"
        timestamptz valid_from
        timestamptz valid_to
        boolean is_current
    }
    dim_product {
        int product_key PK
        text product_id UK
        text product_name
        text category
        numeric list_price
    }
    dim_store {
        int store_key PK
        text store_id UK
        text store_name
        text city
    }
    dim_date {
        int date_key PK "YYYYMMDD"
        date full_date UK
        smallint year
        smallint quarter
        smallint month
        smallint day_of_week
        boolean is_weekend
    }
